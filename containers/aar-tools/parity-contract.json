{
  "schema": "aar-tool-parity-contract/v0",
  "platform": "linux",
  "profiles": {
    "python-core": {
      "requires": [
        "python",
        "characterizer"
      ],
      "prohibits": [
        "android-sdk-assumed",
        "inference-endpoint-assumed",
        "runtime-behavior-accepted"
      ]
    },
    "java-static": {
      "requires": [
        "python",
        "characterizer",
        "java",
        "jadx",
        "jadx_library_set",
        "apktool"
      ],
      "prohibits": [
        "android-sdk-assumed",
        "native-elf-decompiler-assumed",
        "inference-endpoint-assumed",
        "runtime-behavior-accepted"
      ]
    },
    "sdk-mounted": {
      "requires": [
        "python",
        "characterizer",
        "java",
        "jadx",
        "jadx_library_set",
        "apktool",
        "sdk_aapt2",
        "sdk_dexdump",
        "sdk_apksigner",
        "sdk_d8",
        "sdk_android_35"
      ],
      "prohibits": [
        "android-sdk-redistribution",
        "sdk-license-automatic-acceptance",
        "inference-endpoint-assumed",
        "runtime-behavior-accepted"
      ]
    }
  },
  "tools": {
    "python": {
      "path": "/usr/local/bin/python",
      "argv": [
        "--version"
      ]
    },
    "characterizer": {
      "path": "/opt/aar/tools/characterize_android_artifact.py"
    },
    "java": {
      "path": "/usr/bin/java",
      "argv": [
        "-version"
      ]
    },
    "jadx": {
      "path": "/opt/jadx/bin/jadx",
      "argv": [
        "--version"
      ]
    },
    "apktool": {
      "path": "/opt/apktool-3.0.3.jar",
      "sha256": "dbf930b076c6b9be08d57c449cacefc3bdd6b71ebd59b3066fc0e1f5b14f9423"
    },
    "jadx_library_set": {
      "glob": "/opt/jadx/**/*.jar"
    },
    "sdk_aapt2": {
      "path": "/opt/android-sdk/build-tools/37.0.0/aapt2",
      "sha256": "0f1c0e560f99db510a76ebc99ad5c3e68438f62e8e8617018a716ca4a589a699",
      "argv": [
        "version"
      ]
    },
    "sdk_dexdump": {
      "path": "/opt/android-sdk/build-tools/37.0.0/dexdump",
      "sha256": "860eac6a099ae2b3f0e39a1c7e43272f8bab48440c19a941e3fc87de099d7bd6"
    },
    "sdk_apksigner": {
      "path": "/opt/android-sdk/build-tools/37.0.0/apksigner",
      "sha256": "b47549e373b895ce6ca620d0c7887e674d9615ffa837a86ac601dcfd04adb0f0",
      "argv": [
        "version"
      ]
    },
    "sdk_d8": {
      "path": "/opt/android-sdk/build-tools/37.0.0/d8",
      "argv": [
        "--version"
      ]
    },
    "sdk_android_35": {
      "path": "/opt/android-sdk/platforms/android-35/android.jar"
    }
  },
  "checks": {
    "immutable_image_digest": true,
    "arch_specific": true,
    "network_default": "none",
    "rootfs_default": "read-only",
    "capabilities_default": "drop-all",
    "privileged": false,
    "host_docker_socket": false,
    "host_model_secrets": false,
    "external_sdk_mount": "read-only; exactly matched build-tools 37.0.0 x86_64",
    "sdk_redistribution": false
  }
}
